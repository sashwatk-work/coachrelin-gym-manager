# Copy this file to docker/.env.production and replace every blank value.
# Never commit docker/.env.production.
#
#   cp docker/.env.production.example docker/.env.production
#   make production-up

# Public address of the Nginx TLS reverse proxy. No trailing slash.
CRF_PRODUCTION_WEB_ORIGIN=https://console.coachrelin.com
# Hostname only, without https:// or a trailing slash.
CRF_PRODUCTION_DOMAIN=console.coachrelin.com

# Superuser password (init / break-glass only; the app does not use this).
CRF_PRODUCTION_POSTGRES_PASSWORD=
# App role "gym". Use the same value, URL-escaped, in DATABASE_URL.
CRF_PRODUCTION_GYM_DB_PASSWORD=
CRF_PRODUCTION_DATABASE_URL=postgres://gym:CHANGE_ME@postgres:5432/gym?sslmode=disable

# App session signing key. Rotate = everyone is signed out.
CRF_PRODUCTION_JWT_SECRET=

# Absolute host directory for PostgreSQL's persistent files.
# Keep it separate from development, for example /srv/coachrelin/data/postgres.
CRF_PRODUCTION_POSTGRES_DATA_DIR=

# Only Nginx publishes host ports. Backend and PostgreSQL have no production
# host ports. Change these only when another host proxy owns ports 80/443.
CRF_PRODUCTION_HTTP_PORT=80
CRF_PRODUCTION_HTTPS_PORT=443

# Absolute paths to the certificate and private key on the production host.
# For Let's Encrypt these are usually fullchain.pem and privkey.pem.
CRF_PRODUCTION_TLS_CERTIFICATE=
CRF_PRODUCTION_TLS_PRIVATE_KEY=
